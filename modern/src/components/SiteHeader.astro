---
const { currentPath = "/" } = Astro.props;
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/research", label: "Research" },
  { href: "/dashboard", label: "Deer Network" },
  { href: "/search", label: "Search" }
];
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/">Station</a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a
                class="nav-link"
                href={link.href}
                aria-current={currentPath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Shows the mode it will switch to: a moon on light, a sun on dark. */}
    <button class="theme-button" id="theme-toggle" type="button" aria-label="Switch colour theme">
      <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z" />
      </svg>
      <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 1.8v3.1M12 19.1v3.1M4.8 4.8 7 7M17 17l2.2 2.2M1.8 12h3.1M19.1 12h3.1M4.8 19.2 7 17M17 7l2.2-2.2" />
      </svg>
      <span class="visually-hidden">Toggle light and dark mode</span>
    </button>
  </div>
</header>
