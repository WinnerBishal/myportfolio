---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found | Bishal Adhikari" description="That page does not exist.">
  <section class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">No path to that target</h1>
    <p class="not-found__line">
      The page you asked for is not here. It may have moved during the site rebuild, or never existed.
    </p>
    <p class="not-found__actions">
      <a class="button-link" href="/">Home</a>
      <a class="button-link" href="/projects">Projects</a>
      <a class="button-link" href="/research">Research</a>
    </p>
  </section>
</BaseLayout>
